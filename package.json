{
  "name": "cabinet-designer-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run lint:styles && vitest run src",
    "lint:styles": "node scripts/ui-lint/check-styles.mjs",
    "poster:showroom": "node scripts/showroom/render-poster.mjs",
    "stills:apartments": "node scripts/showcase-tour/render-apartment-stills.mjs",
    "media:cards": "node scripts/card-media/capture.mjs",
    "media:cards:clips": "node scripts/card-media/capture.mjs --clips-only",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/calm-light-a11y.spec.ts",
    "test:visual": "playwright test tests/e2e/calm-light-visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/calm-light-visual.spec.ts --update-snapshots",
    "test:golden": "playwright test tests/e2e/golden-cabinet-run.spec.ts tests/e2e/living-room-release.spec.ts --project=chromium",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "assets:curated": "node scripts/curated-assets/generate-pack.mjs",
    "qa:assets": "node scripts/render-qa/check-assets.mjs",
    "qa:render": "node scripts/render-qa/run-unit.mjs",
    "qa:smoke": "playwright test tests/e2e/render-qa-smoke.spec.ts",
    "presentation:sample": "node scripts/client-presentation/build-sample.mjs",
    "presentation:check": "node scripts/client-presentation/check.mjs",
    "presets:list": "node scripts/render-presets/list-presets.mjs",
    "presets:check": "node scripts/render-presets/check.mjs",
    "phase1:proof": "node scripts/phase1-proof/run-scorecard.mjs",
    "phase1:latency": "node scripts/phase1-proof/collect-latency.mjs",
    "stilljob:spike": "node scripts/still-job/export-spike.mjs",
    "stilljob:phase2a": "node scripts/still-job/export-phase2a.mjs",
    "phase2:proof": "node scripts/phase2-proof/run-proof.mjs",
    "catalog:generate": "node scripts/catalog/generate-living-room-thumbnail.mjs && node scripts/catalog/generate-empty-room-thumbnail.mjs && node scripts/catalog/generate-straight-kitchen-thumbnail.mjs && node scripts/catalog/generate-l-kitchen-thumbnail.mjs && node scripts/catalog/generate-bedroom-thumbnail.mjs && node scripts/catalog/generate-bathroom-thumbnail.mjs && node scripts/catalog/generate-kenney-manifest.mjs && npm run catalog:render",
    "catalog:render": "node scripts/catalog/render-catalog-thumbnails.mjs",
    "catalog:verify": "node scripts/catalog/verify-catalog.mjs",
    "catalog:thumbnail": "node scripts/catalog/generate-living-room-thumbnail.mjs && node scripts/catalog/generate-empty-room-thumbnail.mjs && node scripts/catalog/generate-straight-kitchen-thumbnail.mjs && node scripts/catalog/generate-l-kitchen-thumbnail.mjs && node scripts/catalog/generate-bedroom-thumbnail.mjs && node scripts/catalog/generate-bathroom-thumbnail.mjs",
    "tauri": "tauri",
    "release:check": "npm run catalog:verify && npm test && npm run build && npm run test:e2e && cargo test --manifest-path src-tauri/Cargo.toml",
    "release:mac": "npm run tauri build -- --bundles app,dmg",
    "cycles:bundle": "vite-node scripts/cycles/export-bundle.ts --",
    "cycles:render": "node scripts/cycles/render-still.mjs",
    "cycles:check": "node scripts/cycles/render-still.mjs --check && node scripts/cycles/check-bundle-math.mjs",
    "cycles:means": "node scripts/cycles/scan-means.mjs",
    "cycles:serve": "node scripts/cycles/serve.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@mlightcad/libredwg-web": "0.7.14",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "meshoptimizer": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/canvas": "^0.1.80",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.6.0",
    "ffmpeg-static": "^5.2.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^1.6.1"
  }
}
