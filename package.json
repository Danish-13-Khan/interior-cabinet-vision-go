{
  "name": "cabinet-designer-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "assets:curated": "node scripts/curated-assets/generate-pack.mjs",
    "qa:assets": "node scripts/render-qa/check-assets.mjs",
    "qa:render": "node scripts/render-qa/run-unit.mjs",
    "qa:smoke": "playwright test tests/e2e/render-qa-smoke.spec.ts",
    "tauri": "tauri",
    "release:check": "npm test && npm run build && npm run test:e2e && cargo test --manifest-path src-tauri/Cargo.toml",
    "release:mac": "npm run tauri build -- --bundles app,dmg"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^1.6.1"
  }
}
