{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interior Cabinet Designer",
  "version": "0.1.0",
  "identifier": "com.danish.cabinetdesigner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Interior Cabinet Designer",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Plan living rooms and cabinets in synchronized 2D and 3D.",
    "longDescription": "A local-first interior planning desktop application with technical plan editing, synchronized 3D visualization, presentation rendering, and cabinet production workflows.",
    "copyright": "Copyright © 2026 Danish Khan",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
