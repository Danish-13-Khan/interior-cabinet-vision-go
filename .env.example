# Gemini Floor-Plan Vision Lab (local only)
#
# Copy to `.env` and fill in. Never commit `.env` or paste keys into chat.
#
# Required for live Vision calls (offline fixtures work without it):
VITE_GEMINI_API_KEY=

# Optional model id (default: gemini-2.0-flash)
# VITE_GEMINI_MODEL=gemini-2.0-flash

# Optional: expose /lab/gemini-floorplan in production builds (DEV always on)
# VITE_ENABLE_GEMINI_LAB=true
