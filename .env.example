# Gemini Floor-Plan Vision Lab (local only)
#
# Copy to `.env` and fill in. Never commit `.env` or paste keys into chat.
#
# Preferred (Phase 5 proxy): server-side key used by Vite middleware.
# Client does not need VITE_GEMINI_API_KEY when the proxy is on (default in DEV).
GEMINI_API_KEY=

# Optional fallback / legacy client key (avoid for shared demos):
# VITE_GEMINI_API_KEY=

# Optional model id (default: gemini-3.6-flash)
# VITE_GEMINI_MODEL=gemini-3.6-flash

# Proxy: default on in DEV. Set false to force browser-direct key calls.
# VITE_GEMINI_USE_PROXY=true

# Optional: expose /lab/gemini-floorplan in production builds (DEV always on)
# VITE_ENABLE_GEMINI_LAB=true
